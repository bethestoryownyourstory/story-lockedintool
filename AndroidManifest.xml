<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
    <!-- Edit profile > Change photo: STORY shows your pictures itself (instant), after you allow it once. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Notes > Audio File: STORY's own list of the audio on the phone. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Station 3 > Create: the camera (pictures, video) and the microphone (video sound). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Settings > QUICK ACCESS: the dial pad's call button calls straight away (lock screen too). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Station 3 > Call history: when each call made from STORY ended and how long it lasted; contact names. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="Lockedintool"
        android:theme="@style/Theme.Story">

        <!-- Setup screen. STORY does NOT replace your home screen; it floats over it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Update available" for Live users (Update now / Later; required after 3 days). -->
        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Edit profile > Change photo: see-through, opens the phone's own photo picker. -->
        <activity
            android:name=".ProfilePhotoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Delete account: the phone's own fingerprint / face / PIN check (see-through). -->
        <activity
            android:name=".IdentityActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Chats / groups / community posts: the phone's own picker for a document or audio file to send (see-through). -->
        <activity
            android:name=".ChatFileActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Notes > Print: the phone's own print screen (everything else in Notes happens inside STORY). -->
        <activity
            android:name=".NoteMediaActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Dial pad > New contact: the phone's own new-contact screen with the number filled in (see-through). -->
        <activity
            android:name=".ContactAddActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Asks Android once for a permission STORY needs (see-through). -->
        <activity
            android:name=".AskActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Station 3 > Create: the real camera, full screen under STORY's Create window. -->
        <activity
            android:name=".CreateCameraActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Story" />

        <!-- STORY's Always On Display: a dim always-on screen with Station 3 when the screen would turn off. -->
        <activity
            android:name=".AodActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Restarts STORY after a phone restart or an update. -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".InstallResultReceiver" android:exported="false" />

        <!-- STORY's pages as home screen widgets (Dashboard, Money, Wallet, Focus): a picture of the whole page; tap opens it. -->
        <receiver android:name=".DashboardWidget" android:exported="true" android:label="Dashboard">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_dashboard" />
        </receiver>
        <receiver android:name=".NotesWidget" android:exported="true" android:label="Notes">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_notes" />
        </receiver>
        <receiver android:name=".CommunityWidget" android:exported="true" android:label="Community">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_community" />
        </receiver>
        <receiver android:name=".MoneyWidget" android:exported="true" android:label="Money">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_money" />
        </receiver>
        <receiver android:name=".WalletWidget" android:exported="true" android:label="Home / Wallet">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_wallet" />
        </receiver>
        <receiver android:name=".FocusWidget" android:exported="true" android:label="Focus">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_focus" />
        </receiver>

        <!-- Lets Android's own installer open a downloaded update (plan B when the quiet install fails). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.story.launcher.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- The overlay: Station 3 button + the bottom STORY bar, drawn over every app. -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone|camera">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Floating Lockedintool button and bar drawn over other apps at the user's request" />
        </service>

        <!-- Optional: lets STORY open the phone's real recents screen and lock the screen. -->
        <service
            android:name=".StoryMediaListener"
            android:exported="true"
            android:label="Lockedintool music"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>

        <service
            android:name=".StoryAccessibilityService"
            android:exported="true"
            android:label="Lockedintool system actions"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
