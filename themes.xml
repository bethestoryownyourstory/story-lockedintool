<resources>
    <!-- No window animations anywhere in Lockedintool (owner, 29 Oct 2026: 'No entry or exit transitions ... I dont want
         any animations or transitions or delay on the whole app'): every screen opens and closes instantly. -->
    <style name="Theme.Story" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <!-- The see-through helper screens (permission asks, pickers, camera, the phone's switches...). -->
    <style name="Theme.Story.Clear" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <!-- Lockedintool's Home (Only system): SOLID black, never see-through - while the phone switched to it, a see-through
         window let the phone's wallpaper show for a moment (owner, 4 Nov 2026: 'the home screen wallpaper still shows up, I
         can still see it for a moment ... Lockedintool needs to be smooth'). -->
    <style name="Theme.Story.Home" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDisablePreview">false</item>
    </style>
    <!-- The Always On Display. -->
    <style name="Theme.Story.Aod" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <!-- The adult-content block screen. -->
    <style name="Theme.Story.Block" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
